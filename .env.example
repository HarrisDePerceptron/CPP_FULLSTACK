# Optional. Uncomment and paste 64 hexadecimal characters from: openssl rand -hex 32
# APP_JWT_SECRET=

# Each top-level config field can also be set as APP_<UPPERCASE_KEY>.
# Process variables take precedence over this file.
# APP_SERVER='{"bind_address":"127.0.0.1","port":8080,"max_connections":64,"log_level":"info","jwt_lifetime_seconds":1800}'

# Use these for local demo credentials you want to keep out of config.json.
# APP_TEST_USER=local-demo
# APP_TEST_PASSWORD='replace-with-a-local-password'
