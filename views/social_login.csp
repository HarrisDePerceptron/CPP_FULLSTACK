<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Login</title>
    <script src="/public/theme.js"></script>
    <link rel="stylesheet" href="/public/demo.css">
    <script defer src="/public/social.js"></script>
</head>
<body class="antialiased">
    <header class="absolute right-0 top-0 z-10 px-4 py-3 sm:px-7">
        <button type="button" role="switch" aria-checked="true" class="theme-switch" data-theme-switch hidden>
            <span class="theme-track" aria-hidden="true"></span>
            Dark mode
        </button>
    </header>
    <main class="grid min-h-dvh place-items-center px-4 pb-24 pt-16">
        <form id="account" class="panel w-full max-w-md space-y-5 shadow-xl shadow-black/20">
            <h1 id="account-heading" class="text-2xl font-semibold">Sign in</h1>
            <p id="signup-hint" class="text-sm text-muted" hidden>Use 3–32 letters, digits, underscores, or hyphens for your username and at least 8 characters for your password.</p>
            <label class="label">Username
                <input name="username" class="control" autocomplete="username" maxlength="128" required>
            </label>
            <label class="label">Password
                <input name="password" type="password" class="control" autocomplete="current-password" maxlength="1024" required>
            </label>
            <div class="flex flex-wrap gap-2">
                <button class="action" id="account-submit">Sign in</button>
                <button type="button" class="secondary" id="account-mode">Create an account</button>
            </div>
            <p id="account-status" role="status" class="text-sm text-muted"></p>
        </form>
    </main>
</body>
</html>
