<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>App server demo</title>
    <link rel="stylesheet" href="/public/demo.css">
    <script defer src="/public/app.js"></script>
</head>
<body class="bg-sheet text-ink antialiased">
    <main class="mx-auto max-w-6xl px-5 py-8 sm:px-10 sm:py-12">
        <header class="mb-7 border-b border-rule pb-7">
            <h1 class="font-mono text-3xl font-bold tracking-tight sm:text-5xl">App server demo</h1>
            <a href="/social" class="mt-3 inline-block font-semibold text-moss underline">Open the social feed</a>
            <p class="mt-3 max-w-xl text-muted">Try the public routes, sign in with the demo credentials from your configuration or server terminal, and upload a file.</p>
        </header>

        <div class="grid gap-5 lg:grid-cols-[1fr_1.1fr]">
            <div class="space-y-5">
                <section class="panel" aria-labelledby="public-heading">
                    <h2 id="public-heading" class="text-xl font-semibold">Public routes</h2>
                    <div class="mt-4 flex flex-wrap gap-2">
                        <button class="action" id="check-status" type="button">Check server status</button>
                        <button class="secondary" id="fetch-content" type="button">Fetch sample content</button>
                    </div>
                </section>

                <section class="panel" aria-labelledby="session-heading">
                    <div class="flex flex-wrap items-center justify-between gap-2">
                        <h2 id="session-heading" class="text-xl font-semibold">Demo account</h2>
                        <p id="session-status" class="rounded-full border border-rule px-3 py-1 text-sm text-muted" role="status">Signed out</p>
                    </div>
                    <form id="login" class="mt-4 space-y-3">
                        <label class="label">Username
                            <input name="username" class="control" autocomplete="username" maxlength="128" required>
                        </label>
                        <label class="label">Password
                            <input name="password" type="password" class="control" autocomplete="current-password" maxlength="1024" required>
                        </label>
                        <div class="flex flex-wrap gap-2">
                            <button class="action" type="submit">Sign in</button>
                            <button class="secondary" id="whoami" type="button" disabled>Check identity</button>
                            <button class="secondary" id="logout" type="button" disabled>Sign out</button>
                        </div>
                    </form>
                </section>

                <section class="panel" aria-labelledby="upload-heading">
                    <h2 id="upload-heading" class="text-xl font-semibold">Upload a file</h2>
                    <p id="upload-hint" class="mt-2 text-sm text-muted">Sign in and choose a PDF, PNG, JPEG, GIF or WebP up to 10 MiB. Uploaded files get a public download link.</p>
                    <form id="upload" class="mt-4 space-y-3">
                        <label class="label">File
                            <input name="file" type="file" class="control" accept="application/pdf,image/png,image/jpeg,image/gif,image/webp" aria-describedby="upload-hint" required>
                        </label>
                        <button class="action" id="upload-button" type="submit" disabled>Upload file</button>
                    </form>
                </section>
            </div>

            <section class="self-start overflow-hidden rounded-2xl border border-ink bg-ink text-white" aria-labelledby="response-heading">
                <div class="flex flex-wrap items-center justify-between gap-2 border-b border-white/20 px-5 py-4 sm:px-6">
                    <h2 id="response-heading" class="text-lg font-semibold">Response</h2>
                    <p id="response-status" class="font-mono text-xs text-emerald-200" role="status">Ready</p>
                </div>
                <pre id="response-body" class="min-h-44 overflow-auto whitespace-pre-wrap break-words p-5 font-mono text-sm leading-relaxed sm:p-6">Run an action to see its response here.</pre>
                <p id="download-row" class="hidden border-t border-white/20 px-5 py-4 sm:px-6">
                    <a id="download" class="font-semibold text-emerald-200 underline underline-offset-4 focus-visible:outline-emerald-200">Download uploaded file</a>
                </p>
            </section>
        </div>
        <footer class="mt-8 border-t border-rule pt-4 text-sm text-muted">
            Server time <span>[[ server_time ]]</span>
        </footer>
    </main>
</body>
</html>
